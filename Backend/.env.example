PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/organic2home
JWT_SECRET=change-this-to-a-long-random-secret
OTP_EXPIRY_MINUTES=5
CLIENT_ORIGIN=http://localhost:5173
DELIVERY_FEE=30
FREE_DELIVERY_MIN=200

# Razorpay — unused until keys are set; DevPaymentProvider is used
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Static OTP until Twilio keys are set (always 6 digits)
DEV_OTP=000000

# Twilio — when all three are set, OTP becomes random and SMS can be enabled
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
